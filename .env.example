# === Nebius Token Factory (REQUIRED for the Nebius x NVIDIA hackathon: runtime calls must go here) ===
# 1. https://tokenfactory.nebius.com -> sign in -> billing -> apply promo code NEBIUS-DEVPOST-GLOBAL26
# 2. API keys -> Create -> paste below.  Inside NemoClaw/OpenShell the agent only holds a placeholder;
#    the gateway injects the real key at egress.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# One NVIDIA open model (Nemotron) for everything. Thinking off on the live path, on for legal reasoning.
# Run `callpilot models` to list the exact IDs your key can reach.
CALLPILOT_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CALLPILOT_SLOW_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Alternatives on Nebius: nvidia/nemotron-3-super-120b-a12b (reasoner), nvidia/Nemotron-3-Ultra-550b-a55b

# --- Dev fallback only (does NOT satisfy the hackathon platform requirement) ---
#NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
#CALLPILOT_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Speech (optional). Leave empty to use the mock ASR/TTS for development.
RIVA_SERVER=

# Company identity now lives in company.yaml; these are fallbacks if that file is absent.
CALLPILOT_COMPANY_NAME=Acme Inc.
CALLPILOT_DNCL_REGISTERED=false

CALLPILOT_DATA_DIR=./data
