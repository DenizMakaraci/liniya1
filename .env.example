# Inference (Nebius Token Factory, OpenAI-compatible). Inside NemoClaw/OpenShell this key is
# never visible to the agent: register it with `nemoclaw onboard` and the L7 proxy injects it.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Fast path: spoken/whispered suggestions, no reasoning tokens (latency-critical).
CALLPILOT_FAST_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Slow path: pre-call brief + legal reasoning, runs off the critical path.
CALLPILOT_SLOW_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Speech (optional). Leave empty to use the mock ASR/TTS for development.
RIVA_SERVER=
# e.g. localhost:50051 for a local Riva/Parakeet NIM

# Your company (used for mandatory caller identification)
CALLPILOT_COMPANY_NAME=Acme Inc.
CALLPILOT_COMPANY_ADDRESS=123 Main St, Toronto, ON
CALLPILOT_CALLBACK_NUMBER=+1 800 555 0100
CALLPILOT_DNCL_REGISTERED=false

# Storage (kept local; mount a volume in OpenShell)
CALLPILOT_DATA_DIR=./data
