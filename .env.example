# Inference: any OpenAI-compatible endpoint. Inside NemoClaw/OpenShell this key is never visible to
# the agent: register it with `nemoclaw onboard` and the L7 proxy injects it.
#
# build.nvidia.com (free tier, no card):
NEBIUS_API_KEY=nvapi-...
NEBIUS_BASE_URL=https://integrate.api.nvidia.com/v1
# Nebius Token Factory (Builder Program credits):
#NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# One model for everything. Thinking is disabled on the live path (whispers, replies, judge, briefs)
# and enabled for the legal reasoner. Nebius ID: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CALLPILOT_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CALLPILOT_SLOW_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Production upgrade for the reasoner on a dedicated endpoint: nvidia/nemotron-3.5-super-vl-120b-a12b
# (measured ~108 s with thinking on the free tier - too slow for demos)

# Speech (optional). Leave empty to use the mock ASR/TTS for development.
RIVA_SERVER=
# e.g. localhost:50051 for a local Riva / Parakeet / Magpie NIM

# Your company (used for mandatory caller identification)
CALLPILOT_COMPANY_NAME=Acme Inc.
CALLPILOT_COMPANY_ADDRESS=123 Main St, Toronto, ON
CALLPILOT_CALLBACK_NUMBER=+1 800 555 0100
CALLPILOT_DNCL_REGISTERED=false

# Storage (kept local; mount a volume in OpenShell)
CALLPILOT_DATA_DIR=./data
